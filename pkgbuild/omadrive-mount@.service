[Unit]
Description=OneDrive sync folder for omadrive account %i
Documentation=https://github.com/stemerlini/omadrive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/omadrive mount --account %i --foreground
ExecStop=/usr/bin/omadrive unmount --account %i
Restart=on-failure
RestartSec=10
# Time to send the last changes after unmounting; the rest wait in the journal.
TimeoutStopSec=60

[Install]
WantedBy=default.target
