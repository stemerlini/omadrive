pkgname=omadrive
pkgver=0.1.0
pkgrel=1
pkgdesc='Two-pane file manager for local folders and OneDrive'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'libsecret' 'qt6-svg' 'fuse3' 'rclone')
optdepends=('qt6-webengine: PDF previews (QtPdf)'
            'nodejs: MCP server for agents (omadrive agent / omadrive-mcp)')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omadrive "$pkgdir/usr/bin/omadrive"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm755 "$startdir/../mcp/omadrive-mcp.mjs" "$pkgdir/usr/lib/omadrive/mcp/omadrive-mcp.mjs"
  install -Dm644 "$startdir/../mcp/package.json" "$pkgdir/usr/lib/omadrive/mcp/package.json"
  install -Dm644 "$startdir/omadrive.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omadrive.svg"
  install -Dm644 "$startdir/omadrive.desktop" "$pkgdir/usr/share/applications/omadrive.desktop"
  install -Dm644 "$startdir/omadrive-rclone@.service" "$pkgdir/usr/lib/systemd/user/omadrive-rclone@.service"
}
